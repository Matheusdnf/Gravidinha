# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Dashboard > Project Settings > API Keys). Ambas são públicas por design:
# quem protege os dados é o RLS do banco. NUNCA coloque a chave secret/service_role aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
